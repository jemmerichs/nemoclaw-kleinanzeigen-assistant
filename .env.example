# Required: OpenRouter powers the agent runtime.
OPENROUTER_API_KEY=your_key_here
OPENROUTER_MODEL=google/gemini-3.6-flash
OPENROUTER_REASONING_EFFORT=medium
OPENROUTER_MAX_TOKENS=2048
OPENROUTER_DAILY_BUDGET_USD=1.00
OPENROUTER_TOTAL_BUDGET_USD=3.00

# Complexity routing: Flash for normal work, Kimi only for clearly complex turns.
# "manual" uses Kimi only with /high; "off" disables the high tier entirely.
NEMOCLAW_COMPLEXITY_ROUTING=auto
OPENROUTER_HIGH_MODEL=moonshotai/kimi-k3
OPENROUTER_HIGH_REASONING_EFFORT=high
OPENROUTER_HIGH_MAX_TOKENS=2048
OPENROUTER_HIGH_DAILY_BUDGET_USD=0.25

# Safety switch. External writes are blocked unless this is explicitly "live".
NEMOCLAW_MODE=dry-run

# Required for Telegram operation: token from @BotFather
TELEGRAM_BOT_TOKEN=your_token_here

# Required security boundary: numeric owner chat ID. Comma-separate multiple IDs.
# You can learn your ID from @userinfobot on Telegram.
TELEGRAM_ALLOWED_CHAT_ID=123456789

# Optional: where scheduled inbox checks are sent (defaults to the first allowed ID)
# TELEGRAM_HEARTBEAT_CHAT_ID=123456789

# Inbox monitoring: startup check after 10s, then this interval with ±20% jitter.
# Use 0 to disable; otherwise 15–360 minutes.
NEMOCLAW_INBOX_POLL_MINUTES=45

# Listing defaults (kept outside source/prompt documentation)
KA_DEFAULT_ZIP_CODE=00000
# KA_DEFAULT_LOCATION_ID=
# KA_CONTACT_NAME=

# Optional browser channel when Chrome is not auto-detected (for example: chrome)
# PLAYWRIGHT_CHANNEL=chrome

# Written automatically by `npm run login` — do not edit manually
# KA_COOKIES=...
# KA_BEARER_TOKEN=...

# Persistent image storage (default: workspace/images)
# NEMOCLAW_IMAGE_DIR=/absolute/path/to/images
