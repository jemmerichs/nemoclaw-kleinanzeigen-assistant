# Required: token from @BotFather
TELEGRAM_BOT_TOKEN=your_token_here

# Required security boundary: numeric owner chat ID. Comma-separate multiple IDs.
# You can learn your ID from @userinfobot on Telegram.
TELEGRAM_ALLOWED_CHAT_ID=123456789

# Optional: where scheduled inbox checks are sent (defaults to the first allowed ID)
# TELEGRAM_HEARTBEAT_CHAT_ID=123456789

# Optional Claude CLI overrides
# CLAUDE_BIN=/absolute/path/to/claude
# CLAUDE_MODEL=claude-sonnet-4-6
# CLAUDE_TIMEOUT_MS=120000

# Optional browser channel when Chrome is not auto-detected (for example: chrome)
# PLAYWRIGHT_CHANNEL=chrome

# Written automatically by `npm run login` — do not edit manually
# KA_COOKIES=...
# KA_BEARER_TOKEN=...

# Optional image processing via Gemini
# GEMINI_API_KEY=your_key_here
# GEMINI_MODEL=gemini-3.1-flash-image-preview

# Persistent image storage (default: workspace/images)
# NEMOCLAW_IMAGE_DIR=/absolute/path/to/images
