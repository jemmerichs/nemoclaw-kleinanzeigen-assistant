# Telegram bot token — from @BotFather
TELEGRAM_BOT_TOKEN=your_token_here

# Kleinanzeigen credentials — used for automatic login
KA_EMAIL=your@email.de
KA_PASSWORD=your_password

# Session cookies — written automatically after login, do not edit manually
# KA_COOKIES=...

# Note: Anthropic API keys are stored in ~/.nemoclaw — not here.
