# Telegram bot token — from @BotFather
TELEGRAM_BOT_TOKEN=your_token_here

# Kleinanzeigen credentials — used for automatic login
KA_EMAIL=your@email.de
KA_PASSWORD=your_password

# Written automatically by 'node scripts/login.js' — do not edit manually
# KA_COOKIES=...       session cookies incl. access_token + refresh_token (cookie auth + bearer token source)
# KA_BEARER_TOKEN=...  set only after a gateway token refresh; overrides token extracted from KA_COOKIES

# Note: Anthropic API keys are stored in ~/.nemoclaw — not here.
