{
  "name": "nemoclaw-kleinanzeigen",
  "version": "1.1.0",
  "private": true,
  "description": "Kleinanzeigen-Manager mit Telegram-Gateway",
  "main": "workspace/agent.js",
  "scripts": {
    "start": "node workspace/agent.js",
    "setup": "bash scripts/setup.sh",
    "launch": "bash scripts/start.sh",
    "login": "node scripts/login.js",
    "refresh-auth": "node scripts/refresh-cookies.js",
    "check": "node --check workspace/agent.js && node --check tools/kleinanzeigen.js && node --check tools/telegram.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "dotenv": "^16.0.0",
    "playwright": "^1.58.2",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "overrides": {
    "brace-expansion": "1.1.16"
  }
}
